---
import { Code } from 'astro:components'
import MobileNav from '@subfloor/astro/MobileNav.astro'
import Docs from '../layouts/Docs.astro'
import Filler from '../components/Filler.astro'
import ReactNavDemo from '../components/ReactNavDemo'
import TokenTable from '../components/TokenTable.astro'
import { url } from '../lib/url'

const usage = `---
import MobileNav from '@subfloor/astro/MobileNav.astro'
const path = Astro.url.pathname
const links = [
  { href: '/', label: 'Home', current: path === '/' },
  { href: '/work/', label: 'Work', current: path === '/work/' },
  { href: '#contact', label: 'Contact' },
]
---
<button class="menu-toggle" command="show-modal" commandfor="site-nav"
  aria-haspopup="dialog">Menu</button>

<!-- placement: "end" (default) | "start" -->
<MobileNav id="site-nav" links={links} closeAt="(min-width: 768px)">
  <!-- optional: more content below the links -->
</MobileNav>`

const react = `'use client'
import Link from 'next/link'
import { usePathname } from 'next/navigation'
import { MobileNav } from '@subfloor/react'

export function SiteNav() {
  const path = usePathname()
  return (
    <MobileNav
      id="site-nav"
      closeAt="(min-width: 768px)"
      links={[
        { href: '/', label: 'Home', current: path === '/' },
        { href: '/work', label: 'Work', current: path === '/work' },
      ]}
      renderLink={(props) => <Link {...props} />}
    />
  )
}`

const markup = `<dialog id="site-nav" class="sf-dialog sf-mobile-nav" data-sf-dialog
  data-sf-mobile-nav data-placement="end" data-sf-close-at="(min-width: 768px)"
  aria-labelledby="site-nav-title" closedby="any">
  <header class="sf-dialog__header">
    <h2 id="site-nav-title" class="sf-dialog__title">Menu</h2>
    <form method="dialog" class="sf-dialog__close-form">
      <button class="sf-dialog__close" value="close" aria-label="Close menu">…</button>
    </form>
  </header>
  <div class="sf-dialog__body">
    <nav class="sf-mobile-nav__nav" aria-labelledby="site-nav-title">
      <ul class="sf-mobile-nav__list">
        <li><a class="sf-mobile-nav__link" href="/" aria-current="page">Home</a></li>
      </ul>
    </nav>
  </div>
</dialog>`

const custom = `:root {
  /* the heights of your fixed header and bottom bar */
  --sf-fixed-top: 4rem;
  --sf-fixed-bottom: 3.5rem;
  --sf-mobile-nav-width: 100%;
}

/* your own CSS: hide the toggle where the desktop links show */
@media (min-width: 768px) {
  .menu-toggle { display: none; }
}`

const links = [
  { href: url('/'), label: 'Overview' },
  { href: url('/modal/'), label: 'Modal' },
  { href: url('/drawer/'), label: 'Drawer and Sheet' },
  { href: url('/mobile-nav/'), label: 'Mobile nav', current: true },
  { href: '#customisation', label: 'Customisation (on this page)' },
  { href: '#nav-target', label: 'The end of this page' },
]
---

<Docs
  title="Mobile nav"
  description="The phone menu: the modal dialog with a list of links. Following a link closes it, also with a client-side router, and in-page links land where they point."
>
  <section class="demo" aria-label="Demo">
    <button
      id="open-nav"
      class="primary"
      command="show-modal"
      commandfor="site-nav"
      aria-haspopup="dialog"
    >
      Open menu
    </button>
    <button id="background-button" type="button">
      A button on the page
    </button>
  </section>
  <p>
    The toggle stays visible here so you can try it at any width. On a real site
    you hide it where the desktop links show, and
    <code>closeAt</code> closes the menu when the window grows to that width.
  </p>

  <MobileNav id="site-nav" links={links} closeAt="(min-width: 768px)">
    <p class="nav-note">Anything else goes below the links.</p>
  </MobileNav>

  <h2>Astro</h2>
  <Code code={usage} lang="astro" />

  <h2>React and Next.js</h2>
  <p>
    <code>renderLink</code> renders each link with your router's
    <code>Link</code>. The demo below uses a stand-in router that changes the
    URL with <code>history.pushState</code>.
  </p>
  <Code code={react} lang="tsx" />
  <ReactNavDemo client:load />

  <h2>Markup</h2>
  <Code code={markup} lang="html" />

  <h2>Behaviour</h2>
  <ul>
    <li>
      Everything the <a href={url('/modal/')}>Modal</a> does: scroll lock, focus
      held in the menu and returned to the toggle, Escape, backdrop, inert page.
      Focus can never land on the page hidden behind the menu, and that includes
      the skip link.
    </li>
    <li>
      A followed link closes it with reason <code>navigate</code>. If a router
      changed the URL while the menu was open, the new page starts at the top
      rather than at the old scroll position.
    </li>
    <li>
      A link to a place on this page closes the menu first and then goes there.
      Tab carries on from the target.
    </li>
    <li>
      <code>closeAt</code> (<code>data-sf-close-at</code>) closes it when the
      media query starts to match. An invalid query never matches.
    </li>
    <li>
      Links opened in a new tab (modifier keys, <code>target="_blank"</code>,
      <code>download</code>) leave the menu open.
    </li>
  </ul>

  <h2>Without JavaScript</h2>
  <p>
    The toggle opens it in browsers with Invoker Commands; Escape and the close
    button close it, and links to other pages work. Without the script, a link
    to this page leaves the menu open, the menu does not close when the window
    grows, and the closing transition is skipped.
  </p>

  <h2 id="customisation">Customisation</h2>
  <p>
    Set <code>--sf-fixed-top</code> and <code>--sf-fixed-bottom</code> to the
    heights of your fixed bars. They become the root's
    <code>scroll-padding</code>, so Tab and in-page links keep focused controls
    and targets clear of the bars. Your own <code>scroll-padding</code>{' '}
    overrides them, so set the tokens instead. This page has a fixed bar at the
    bottom and sets <code>--sf-fixed-bottom: 3.5rem</code>.
  </p>
  <Code code={custom} lang="css" />
  <TokenTable only={['mobile-nav', 'fixed', 'current', 'touch-target']} />

  <section class="r15" aria-label="Fixed bar check">
    <label>
      Before the gap <input id="r15-before" />
    </label>
    <div class="r15-gap"></div>
    <label>
      Kept above the fixed bar <input id="r15-button" />
    </label>
  </section>

  <h2>Background</h2>
  <Filler />

  <section id="nav-target" aria-labelledby="nav-target-title">
    <h2 id="nav-target-title">The end of this page</h2>
    <label>
      The first control here <input id="after-target" />
    </label>
    <Filler paragraphs={8} label="After" />
  </section>

  <div class="fixed-bar" aria-hidden="true">
    A fixed bar, 3.5rem tall
  </div>
</Docs>

<style is:global>
  :root {
    --sf-fixed-bottom: 3.5rem;
  }

  main {
    padding-bottom: 4rem;
  }
</style>

<style>
  .fixed-bar {
    position: fixed;
    inset: auto 0 0;
    display: grid;
    height: 3.5rem;
    place-items: center;
    border-top: 1px solid var(--sf-color-border);
    background: var(--sf-color-surface);
    color: var(--sf-color-muted);
    font-size: 0.875rem;
  }

  .r15-gap {
    height: 100vh;
  }

  .nav-note {
    margin: var(--sf-space-3);
    color: var(--sf-color-muted);
  }
</style>
