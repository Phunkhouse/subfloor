---
import { Code } from 'astro:components'
import Modal from '@subfloor/astro/Modal.astro'
import Docs from '../layouts/Docs.astro'
import Filler from '../components/Filler.astro'
import TokenTable from '../components/TokenTable.astro'

const astroUsage = `---
import Modal from '@subfloor/astro/Modal.astro'
---
<button command="show-modal" commandfor="delete-project">Delete project</button>

<Modal id="delete-project" title="Delete project?">
  <p>This removes the project and its history.</p>
  <form method="dialog" slot="footer">
    <button value="cancel">Cancel</button>
    <button value="delete">Delete</button>
  </form>
</Modal>`

const markup = `<button command="show-modal" commandfor="delete-project">Delete project</button>

<dialog id="delete-project" class="sf-dialog" data-sf-dialog data-placement="center"
        aria-labelledby="delete-project-title" closedby="any">
  <header class="sf-dialog__header">
    <h2 id="delete-project-title" class="sf-dialog__title">Delete project?</h2>
    <form method="dialog" class="sf-dialog__close-form">
      <button class="sf-dialog__close" value="close" aria-label="Close">…</button>
    </form>
  </header>
  <div class="sf-dialog__body">…</div>
  <footer class="sf-dialog__footer">…</footer>
</dialog>

<script type="module">
  import { initDialogs } from '@subfloor/core'
  initDialogs()
</script>`

const custom = `/* Your stylesheet, unlayered or in a layer after subfloor */
.compact-modal {
  --sf-dialog-width: 20rem;
  --sf-radius-overlay: 0;
  --sf-color-backdrop: rgb(37 99 235 / 35%);
}`

const events = `const dialog = document.getElementById('delete-project')
dialog.addEventListener('sf:open-change', (event) => {
  // { open: false, reason: 'escape' | 'backdrop' | 'button' | 'api' }
  console.log(event.detail)
  if (!event.detail.open) console.log(dialog.returnValue) // 'delete' or 'cancel'
})`
---

<Docs
  title="Modal"
  description="A centred dialog for a decision or a short task. The page behind it neither scrolls nor takes focus."
>
  <section class="demo" aria-label="Demo">
    <button
      id="open-modal"
      class="primary"
      command="show-modal"
      commandfor="demo-modal"
    >
      Delete project
    </button>
    <button id="open-long-modal" command="show-modal" commandfor="long-modal">
      Open a long modal
    </button>
    <button
      id="open-custom-modal"
      command="show-modal"
      commandfor="custom-modal"
    >
      Open a customised modal
    </button>
    <button id="background-button" type="button">
      A button on the page
    </button>
  </section>

  <Modal id="demo-modal" title="Delete project?">
    <p>This removes the project and its history. You can not undo it.</p>
    <label>
      Type the project name to confirm
      <input id="modal-input" name="confirm" autocomplete="off" />
    </label>
    <form method="dialog" slot="footer">
      <button value="cancel">Cancel</button>
      <button value="delete" class="primary">
        Delete
      </button>
    </form>
  </Modal>

  <Modal id="long-modal" title="Terms">
    <Filler paragraphs={20} label="Term" />
  </Modal>

  <Modal id="custom-modal" class="compact-modal" title="Customised">
    <p>
      Narrower, square and with a blue backdrop, from three token overrides.
    </p>
  </Modal>

  <h2>Astro</h2>
  <Code code={astroUsage} lang="astro" />
  <p>
    The trigger is a plain button with <code>command</code> and{' '}
    <code>commandfor</code>; it needs no script in browsers with Invoker
    Commands, and the core runs it in the others. Any
    <code>&lt;form method="dialog"&gt;</code> inside closes the dialog and sets
    its
    <code>returnValue</code>.
  </p>

  <h2>Markup</h2>
  <p>What the adapters render, for any other framework or plain HTML.</p>
  <Code code={markup} lang="html" />

  <h2>Behaviour</h2>
  <ul>
    <li>
      The page does not scroll while it is open, including touch scrolling in
      iOS Safari, and does not shift sideways when its scrollbar goes. The
      scroll position is the same after closing.
    </li>
    <li>
      Focus moves in, stays in and goes back to the button that opened it.
    </li>
    <li>
      Escape, the close button and a click on the backdrop close it. A drag that
      starts inside and ends on the backdrop does not.
    </li>
    <li>
      Everything behind it is inert. <code>data-state</code> is{' '}
      <code>open</code>,<code>closing</code> or <code>closed</code>; the closing
      transition plays before it leaves.
    </li>
    <li>
      <strong>Without JavaScript</strong>, in browsers with Invoker Commands: it
      opens, Escape and the close button close it, the page does not scroll
      (except by touch in iOS Safari), and the backdrop closes it where{' '}
      <code>closedby</code> is supported. The closing transition needs the
      script.
    </li>
  </ul>

  <h2>Events</h2>
  <Code code={events} lang="js" />

  <h2>Customisation</h2>
  <Code code={custom} lang="css" />
  <p>
    Variants are data attributes (<code>data-placement</code>), state is{' '}
    <code>data-state</code>, and the parts have <code>sf-dialog__*</code>{' '}
    classes you can style directly.
  </p>
  <TokenTable
    only={['dialog', 'overlay', 'backdrop', 'duration', 'ease', 'title']}
  />

  <h2>Background</h2>
  <Filler />
</Docs>

<style is:global>
  .compact-modal {
    --sf-dialog-width: 20rem;
    --sf-radius-overlay: 0;
    --sf-color-backdrop: rgb(37 99 235 / 35%);
  }
</style>
